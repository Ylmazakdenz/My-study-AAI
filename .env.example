# Bu dosyayı .env olarak kopyalayın: cp .env.example .env   (Windows: copy .env.example .env)
# .env repoya GİRMEZ (.gitignore'da).

# Ollama sunucusu. Yerel kurulumda (Ollama Mac/Windows uygulaması) ve hocanın Colab kurulumunda aynı:
OLLAMA_HOST=http://localhost:11434
# İndirdiğiniz modelle aynı olmalı (ollama pull ...). Hocanın notebook'undaki 3B model: llama3.2
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TEMPERATURE=0.2
OLLAMA_TIMEOUT=300

# Wikimedia, isteklerde iletişim bilgisi içeren User-Agent ister. Kendi e-postanızı yazın (zorunlu değil, önerilir).
CONTACT_EMAIL=
